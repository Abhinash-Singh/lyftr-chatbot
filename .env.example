# At least 2 API keys, comma-separated. Key IDs are key_1, key_2, ... in order.
LLM_API_KEYS=your-api-key-1,your-api-key-2

# LiteLLM model identifier (default: gemini/gemini-2.0-flash)
LLM_MODEL=gemini/gemini-2.0-flash

# SQLite database location (default: sqlite:////data/app.db)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed by the backend
ALLOWED_ORIGINS=http://localhost:3000

# Enable the X-Simulate-Failure test hook (true / false)
ENABLE_FAILURE_SIMULATION=true

# Backend URL the frontend talks to (build-time for Vite)
VITE_API_URL=http://localhost:8000

# Optional default system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
